{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "build main",
            "command": "g++",
            "args": [
                "-g",
                "${workspaceFolder}/src/connect.cpp",
                "${workspaceFolder}/src/data.cpp",
                "${workspaceFolder}/src/main.cpp",
                "-o",
                "${workspaceFolder}/build/main.exe",
                "-IF:\\msys2\\mingw64\\include",
                "-LF:\\msys2\\mingw64\\lib",
                "-lcurl",
                "-lcjson"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "detail": "编译命令行版 main.exe"
        },
        {
            "type": "shell",
            "label": "build dll",
            "command": "g++",
            "args": [
                "-shared",
                "-g",
                "-std=c++17",
                "-DBILI_EXPORTS",
                "${workspaceFolder}/src/connect.cpp",
                "${workspaceFolder}/src/data.cpp",
                "${workspaceFolder}/src/bili_export.cpp",
                "-o",
                "${workspaceFolder}/build/BiliNative.dll",
                "-IF:\\msys2\\mingw64\\include",
                "-LF:\\msys2\\mingw64\\lib",
                "-lcurl",
                "-lcjson"
            ],
            "group": { "kind": "build", "isDefault": false },
            "problemMatcher": ["$gcc"],
            "detail": "编译 C# 用的 BiliNative.dll"
        }
    ]
}